{
  "schema_version": "research-fields-v0.1-provisional",
  "status": "PROVISIONAL. Not approved by the SPA domain owner. Lock with the stakeholder before any reporting use.",
  "principle": "Extract only what lives in document narrative. Sponsor, amounts, dates, PI, unit, campus and outcome come from Kuali/EDW columns, not from the model.",
  "types": {
    "evidence": "The value is the exact source text, copied by code from the selected evidence IDs.",
    "enum": "One value from the listed options, with supporting evidence IDs.",
    "multi_enum": "Zero or more values from a controlled vocabulary, each with its own evidence IDs.",
    "labels": "Short model-written labels (interpretation, not quotation), each with supporting evidence IDs."
  },
  "vocabularies": {
    "compliance_flags": {
      "human_subjects": ["human subjects", "human participants", "IRB", "informed consent"],
      "clinical_trial": ["clinical trial", "randomized controlled", "phase I", "phase II"],
      "animal_subjects": ["vertebrate animals", "IACUC", "mice", "animal subjects"],
      "biosafety": ["biosafety", "IBC", "recombinant DNA", "select agent"],
      "bsl2_facility": ["BSL-2", "biosafety level 2"],
      "hazardous_materials": ["hazardous materials", "hazardous chemicals"],
      "lasers": ["laser"],
      "radioactive_materials": ["radioactive", "radioisotope", "radiation safety"],
      "nagpra": ["NAGPRA", "Native American Graves"],
      "cui": ["controlled unclassified information", "CUI"],
      "classified": ["classified information", "security clearance"],
      "export_control": ["export control", "ITAR", "EAR"],
      "privacy_hipaa": ["HIPAA", "protected health information"],
      "privacy_gdpr": ["GDPR"],
      "privacy_pipl": ["PIPL"]
    },
    "facilities_needs": {
      "hpc": ["high performance computing", "HPC", "supercomputer", "computing cluster"],
      "ml_ai": ["machine learning", "artificial intelligence", "deep learning", "GPU"],
      "bioprocessing_fermentation": ["bioprocessing", "fermentation", "bioreactor"],
      "genomics_dna_services": ["sequencing", "genomics", "DNA services"],
      "flow_cytometry": ["flow cytometry"],
      "proteomics_metabolomics_spatial": ["proteomics", "metabolomics", "spatial transcriptomics"],
      "mri": ["MRI", "magnetic resonance imaging"],
      "pet_spect": ["PET", "SPECT"],
      "nmr": ["NMR", "nuclear magnetic resonance"],
      "mass_spectrometry": ["mass spectrometry"],
      "maldi_tof": ["MALDI-TOF"],
      "microscopy": ["microscopy", "electron microscope", "confocal"]
    },
    "population_focus": {
      "pediatric": ["children", "pediatric", "adolescents", "infants"],
      "older_adults": ["older adults", "aging population", "elderly"],
      "rural": ["rural"],
      "underserved": ["underserved", "low-income", "health disparities"],
      "veterans": ["veterans"],
      "tribal_nations": ["tribal", "Indigenous"],
      "k12_students": ["K-12", "high school students", "middle school"]
    },
    "topic_watchlist": {
      "clean_energy": ["renewable energy", "solar", "wind energy", "green energy", "decarbonization"],
      "climate": ["climate change", "climate resilience"],
      "fusion": ["fusion energy", "plasma confinement", "tokamak"],
      "community_impact": ["community engagement", "community partners", "community impact"],
      "broadening_participation": ["broadening participation", "diversity", "equity", "inclusion"],
      "artificial_intelligence": ["artificial intelligence", "machine learning"],
      "quantum": ["quantum"],
      "semiconductors": ["semiconductor", "microelectronics"]
    },
    "award_terms_flags": {
      "cost_share_required": ["cost share", "cost sharing", "matching funds"],
      "multi_pi": ["multiple principal investigators", "multi-PI", "contact PI"],
      "special_reporting": ["special reporting", "additional reporting", "quarterly report"],
      "prior_approval_required": ["prior approval", "prior written approval"],
      "carryforward_restricted": ["carryover", "carryforward", "carry forward"],
      "program_income": ["program income"],
      "publication_review": ["publication review", "prior to publication", "acknowledge the support"],
      "data_sharing_requirement": ["data sharing", "data management and sharing"],
      "foreign_participation_restriction": ["foreign component", "foreign national", "foreign entity"],
      "payment_restriction": ["drawdown", "payment restriction", "reimbursement basis"]
    }
  },
  "fields": [
    {"id": "research_themes", "family": "proposal", "type": "labels", "max_items": 6,
     "description": "Specific research themes or topics of the proposed work, finer than HERDS fields.",
     "keywords": ["this project", "we propose", "research on", "focuses on", "investigate"]},
    {"id": "methods", "family": "proposal", "type": "labels", "max_items": 6,
     "description": "Research methods or approaches the proposal says it will use.",
     "keywords": ["we will use", "approach", "methods", "survey", "experiment", "longitudinal", "simulation"]},
    {"id": "specific_aims", "family": "proposal", "type": "evidence",
     "description": "The stated aims, objectives or research questions of the project.",
     "keywords": ["aim", "objective", "we will", "research question", "hypothesis"]},
    {"id": "translational_stage", "family": "proposal", "type": "enum",
     "options": {"basic": ["fundamental", "mechanism", "basic research"], "translational": ["translational", "clinical application", "bench to bedside"], "applied": ["applied", "deployment", "field implementation"]},
     "description": "Whether the work is basic, translational or applied, as supported by the text."},
    {"id": "population_focus", "family": "proposal", "type": "multi_enum", "vocabulary": "population_focus",
     "description": "Specific populations the research focuses on or serves."},
    {"id": "external_collaborators", "family": "proposal", "type": "labels", "max_items": 10,
     "description": "External institutions or partner organizations named as collaborators, as written. No individual names.",
     "keywords": ["in collaboration with", "partner institution", "subaward to", "collaborators at"]},
    {"id": "solicitation_reference", "family": "proposal", "type": "evidence",
     "description": "The funding opportunity, solicitation, RFA or program announcement the proposal responds to.",
     "keywords": ["solicitation", "funding opportunity", "RFA", "PAR-", "NOFO", "program announcement"]},
    {"id": "compliance_flags", "family": "both", "type": "multi_enum", "vocabulary": "compliance_flags",
     "description": "Compliance-relevant activities or materials the document states are involved."},
    {"id": "facilities_needs", "family": "proposal", "type": "multi_enum", "vocabulary": "facilities_needs",
     "description": "Core facilities or infrastructure the work requires or uses."},
    {"id": "topic_watchlist", "family": "both", "type": "multi_enum", "vocabulary": "topic_watchlist",
     "description": "Whether the document substantively concerns watchlist topics leadership asks about."},
    {"id": "award_document_type", "family": "award", "type": "enum",
     "options": {"notice_of_award": ["notice of award", "grant award"], "modification": ["modification", "amendment", "revised notice"], "contract": ["contract", "cooperative agreement"], "subaward_agreement": ["subaward", "subrecipient"], "other": []},
     "description": "What kind of award document this actually is, based on its content."},
    {"id": "award_action", "family": "award", "type": "enum",
     "options": {"new": ["new award"], "renewal": ["renewal", "competing continuation"], "supplement": ["supplement"], "no_cost_extension": ["no-cost extension", "no cost extension"], "continuation": ["non-competing continuation", "continuation"], "other": []},
     "description": "The award action the document states."},
    {"id": "reporting_requirements", "family": "award", "type": "evidence",
     "description": "Reports, deliverables to the sponsor, their due dates and cadence.",
     "keywords": ["report", "due", "within days", "annual", "quarterly", "final report", "progress report"]},
    {"id": "deliverables", "family": "award", "type": "evidence",
     "description": "Deliverables or milestones the award requires.",
     "keywords": ["deliverable", "milestone", "shall deliver", "shall provide"]},
    {"id": "award_terms_flags", "family": "award", "type": "multi_enum", "vocabulary": "award_terms_flags",
     "description": "Special terms and conditions stated in the award document."},
    {"id": "fa_terms", "family": "award", "type": "evidence",
     "description": "Facilities and administrative (indirect) cost terms, especially limited, waived or non-standard rates.",
     "keywords": ["indirect cost", "F&A", "facilities and administrative", "rate", "MTDC", "waive"]},
    {"id": "performance_period_as_stated", "family": "award", "type": "evidence",
     "description": "The period of performance or budget period as written in the document.",
     "keywords": ["period of performance", "budget period", "project period", "through"]},
    {"id": "closeout_requirements", "family": "award", "type": "evidence",
     "description": "Closeout obligations and deadlines.",
     "keywords": ["closeout", "close-out", "final invoice", "within 120 days", "within 90 days"]}
  ]
}
